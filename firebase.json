{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "medkeen",
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "exportOnExit": "./emulator-data/auth"
    },
    "functions": { "port": 5001 },
    "firestore": {
      "port": 9090,
      "exportOnExit": "./emulator-data/firestore"
    },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}

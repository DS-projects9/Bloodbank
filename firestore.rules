rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isRole(r) { return request.auth.token.role == r; }
    function isVerified() { return request.auth.token.verified == true; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(uid);
    }

    // ---------- schedule config (doctor availability) ----------
    match /schedule_config/{uid} {
      allow read: if isSignedIn() && (isVerified() || isOwner(uid));
      allow write: if isSignedIn() && isOwner(uid) && isRole('DOCTOR');
    }

    // ---------- slots (published weekly by doctors via backend) ----------
    match /slots/{slotId} {
      allow read: if isSignedIn() && isVerified();
      allow write: if false; // managed by backend via Admin SDK
    }

    // ---------- appointments ----------
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.patientUid) || isOwner(resource.data.doctorUid));
      allow write: if false; // managed by backend via Admin SDK
    }

    // ---------- vault (document metadata + sharing) ----------
    match /vault/{documentId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.ownerUid) ||
        (resource.data.sharedWith != null && resource.data.sharedWith.hasAny([request.auth.uid]))
      );
      allow write: if false; // managed by backend via Admin SDK
    }

    // ---------- blood requests ----------
    match /blood_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // managed by backend via Admin SDK
      allow delete: if false;
    }

    // ---------- blood donations (donor bookings) ----------
    match /blood_donations/{bookingId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.donorUid) ||
        isRole('BLOOD_BANK')
      );
      allow create: if isSignedIn();
      allow update: if false; // managed by backend via Admin SDK
      allow delete: if false;
    }

    // ---------- blood inventory (per blood bank) ----------
    match /blood_inventory/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // managed by backend via Admin SDK
    }

    // ---------- blood grants (fulfillment records) ----------
    match /blood_grants/{grantId} {
      allow read: if isSignedIn();
      allow write: if false; // managed by backend via Admin SDK
    }

    // ---------- AI sessions ----------
    match /ai_sessions/{sessionId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.uid);
    }

    // ---------- legacy collections ----------
    match /doctors/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /donors/{uid} {
      allow read: if isSignedIn() && isVerified();
      allow write: if isSignedIn() && isOwner(uid);
    }
    match /blood_banks/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /verifications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isRole('ADMIN');
      allow delete: if false;
    }
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isRole('ADMIN') || resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }
    match /ai_threads/{threadId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.patientId);
    }
    match /report_summaries/{summaryId} {
      allow read, write: if isSignedIn() && isOwner(resource.data.patientId);
    }
  }
}

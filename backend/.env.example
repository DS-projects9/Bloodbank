# MedKeen backend environment template.
# Copy to `backend/.env` for local dev, or supply these as Cloud Run env vars
# (JWT_SECRET must come from Secret Manager — never bake it into the image).
#
# Generate a strong secret with:  openssl rand -base64 48

PORT=8080

# --- PostgreSQL (use Cloud SQL socket form on Cloud Run) ---
JDBC_URL=jdbc:postgresql://localhost:5432/medkeen
JDBC_USER=medkeen
JDBC_PASSWORD=change-me

# --- Object storage (MinIO locally; on Cloud Run point at the public URL) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=medkeen

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=medkeen
JWT_AUDIENCE=medkeen-app
JWT_REALM=medkeen

# --- Misc ---
SEED_DEMO_DATA=false

# Public base URL of THIS backend once deployed (informational)
MEDKEEN_PUBLIC_URL=https://replace-medkeen-backend.a.run.app
# ---- Local development (.env) ----
# Copy this file to .env and adjust. In local dev, set the emulator hosts
# below. The backend detects emulator mode from FIRESTORE_EMULATOR_HOST.
#
# ---- Production ----
# Do NOT set the FIREBASE_*_EMULATOR_HOST variables in production.
# The backend then uses Application Default Credentials (the Cloud Run
# service account). Required production vars:
#   GOOGLE_CLOUD_PROJECT = your GCP project id
#   OPENAI_API_KEY       = optional, for AI features (use Secret Manager)
#   CRON_SECRET          = shared secret for /api/v1/cron/run (use Secret Manager)

# Server
PORT=8080

# GCP
GOOGLE_CLOUD_PROJECT=medvault-11c68

# OpenAI (optional - for AI features)
OPENAI_API_KEY=

# Cron trigger secret (use Secret Manager in production)
CRON_SECRET=

# ---- Local emulator overrides (omit in production) ----
# FIRESTORE_EMULATOR_HOST=localhost:9090
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Local validation image: reuses the prebuilt installDist (no Gradle download needed).
# The production path uses backend/Dockerfile via Cloud Build (which has network).
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY backend/build/install/medkeen-backend/ /app/
EXPOSE 8080
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
CMD ["/app/bin/medkeen-backend"]

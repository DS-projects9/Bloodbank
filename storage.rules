rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Encrypted health vault documents. Only the owning patient may
    // read/write their own path directly. Time-boxed doctor access is
    // granted server-side by getSharedFile (admin SDK signed URLs),
    // never by opening this rule up.
    match /vault/{patientId}/{anyFile=**} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
    }

    // Avatar / public images per user
    match /avatars/{userId}/{anyFile=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Verification documents uploaded by doctors / blood banks (admin views)
    match /verification/{userId}/{anyFile=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
# ============================================================
# MedVault environment template. Copy to `.env` and fill.
# NEVER commit real `.env`. Values are project-specific, not secrets
# to share. Firebase keys belong to YOUR project and are prefixed
# with EXPO_PUBLIC_ so Expo inlines them at build time.
# ============================================================

# --- App (Firebase web config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Runtime behaviour (no secrets) ---
EXPO_PUBLIC_FIREBASE_REGION=asia-south1

# --- Google OAuth client ids (from Google Cloud console) ---
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=

# --- Functions deployment / Secret Manager ---
# FIREBASE_PROJECT_ID (= EXPO_PUBLIC_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=
# GEMINI_API_KEY is stored in Secret Manager at deploy time, NOT here.